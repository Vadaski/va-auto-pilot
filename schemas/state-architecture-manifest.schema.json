{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vadaski.github.io/va-auto-pilot/schemas/state-architecture-manifest.schema.json",
  "title": "VA Auto-Pilot State Architecture Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "architecturePlanSha256",
    "reviewLedger",
    "artifactFiles",
    "requiredSchemas",
    "architectureGates",
    "publicMetaProfiles"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "architecturePlanSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "reviewLedger": { "type": "string", "minLength": 1 },
    "artifactFiles": {
      "type": "object",
      "required": ["writerInventory", "terminalInventory", "workspaceIsolationPolicy", "bootstrapReview"],
      "properties": {
        "writerInventory": { "type": "string", "minLength": 1 },
        "terminalInventory": { "type": "string", "minLength": 1 },
        "workspaceIsolationPolicy": { "type": "string", "minLength": 1 },
        "bootstrapReview": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requiredSchemas": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "architectureGates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "publicMetaProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profileId", "entrypoint", "mode", "routeScope", "stdoutOnly"],
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["read-only", "mutating"] },
          "routeScope": { "type": "string", "minLength": 1 },
          "stdoutOnly": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
