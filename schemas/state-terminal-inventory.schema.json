{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vadaski.github.io/va-auto-pilot/schemas/state-terminal-inventory.schema.json",
  "title": "VA Auto-Pilot State Terminal Inventory",
  "type": "object",
  "required": ["schemaVersion", "architecturePlanSha256", "surfaces"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "architecturePlanSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surfaceId", "entrypoint", "kind", "terminalStates"],
        "properties": {
          "surfaceId": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "terminalStates": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
