{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://va-auto-pilot.local/schemas/permission-scope.schema.json",
  "title": "VA Auto-Pilot Permission Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileScopes", "commands", "network", "review"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fileScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "access"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path or glob that the task may touch."
          },
          "access": {
            "enum": ["read", "write", "read-write"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny", "destructiveRequiresOptIn", "destructiveAllow"],
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deny": {
          "type": "array",
          "items": { "type": "string" }
        },
        "destructiveRequiresOptIn": {
          "type": "boolean"
        },
        "destructiveAllow": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowlist"],
      "properties": {
        "mode": {
          "enum": ["none", "allowlist", "unrestricted"]
        },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnOnOutOfScopeDiff"],
      "properties": {
        "warnOnOutOfScopeDiff": {
          "type": "boolean"
        }
      }
    }
  }
}
