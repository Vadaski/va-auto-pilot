{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vadaski.github.io/va-auto-pilot/schemas/bootstrap-review-manifest.schema.json",
  "title": "VA Auto-Pilot Bootstrap Review Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "architecturePlanSha256",
    "reviewLedger",
    "reviewRoster",
    "trustBoundary"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "architecturePlanSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "reviewLedger": { "type": "string", "minLength": 1 },
    "reviewRoster": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "trustBoundary": {
      "type": "object",
      "required": ["readOnlyProfiles", "mutatingProfiles", "protectedArtifacts", "cutoverBlockedTracks", "rule"],
      "properties": {
        "readOnlyProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mutatingProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "protectedArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cutoverBlockedTracks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
