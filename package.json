{
  "name": "va-auto-pilot",
  "version": "0.2.1",
  "description": "CLI-first autonomous multi-agent engineering loop for any codebase",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vadaski/va-auto-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/Vadaski/va-auto-pilot/issues"
  },
  "homepage": "https://github.com/Vadaski/va-auto-pilot#readme",
  "bin": {
    "va-auto-pilot": "bin/va-auto-pilot.mjs"
  },
  "files": [
    "bin/",
    "scripts/auto-pilot-gates.mjs",
    "scripts/auto-pilot-goal.mjs",
    "scripts/auto-pilot-intervene.mjs",
    "scripts/auto-pilot-loop.mjs",
    "scripts/auto-pilot-meta.mjs",
    "scripts/auto-pilot-plan-from-goal.mjs",
    "scripts/auto-pilot-progress-iterate.mjs",
    "scripts/auto-pilot-intent.mjs",
    "scripts/auto-pilot-observe.mjs",
    "scripts/auto-pilot-orchestrate.mjs",
    "scripts/auto-pilot.mjs",
    "scripts/doc-store-cli.mjs",
    "scripts/doc-store-demo.mjs",
    "scripts/doc-store-precommit.mjs",
    "scripts/generate-observability-examples.mjs",
    "scripts/lib/",
    "scripts/smoke-test-runner.mjs",
    "scripts/review-fallback.mjs",
    "scripts/sprint-board.mjs",
    "scripts/test-runner.ts",
    "scripts/validate-mcp-resources.mjs",
    "scripts/validate-observability.mjs",
    "scripts/validate-public-narrative.mjs",
    "scripts/validate-protocol-fixtures.mjs",
    "scripts/validate-runtime-proof.mjs",
    "scripts/va-parallel-runner.mjs",
    "scripts/validate-distribution.mjs",
    "schemas/",
    "templates/",
    "skills/",
    "docs/operations/",
    "docs/articles/reopen-va-auto-pilot-harness-loop.zh.md",
    "docs/articles/va-auto-pilot-why-this-is-the-future.zh.md",
    "docs/comparisons/",
    "docs/human-on-the-loop.md",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run check:all",
    "check": "node ./bin/va-auto-pilot.mjs --help",
    "check:sprint": "node ./scripts/sprint-board.mjs summary --validate",
    "check:units": "node --test tests/*.test.mjs ./scripts/test-units.mjs",
    "check:doc-store": "node ./scripts/test-doc-store.mjs",
    "check:doc-store-mode": "node ./scripts/test-doc-store-mode.mjs",
    "check:cli-flows": "node ./scripts/test-cli-flows.mjs --all",
    "check:observability": "node ./scripts/validate-observability.mjs",
    "check:mcp-resources": "node ./scripts/validate-mcp-resources.mjs",
    "check:protocol-fixtures": "node ./scripts/validate-protocol-fixtures.mjs",
    "check:runtime-proof": "node ./scripts/validate-runtime-proof.mjs",
    "check:fault-injection": "node ./scripts/fault-injection-soak.mjs --iterations 3",
    "check:smoke": "node ./scripts/smoke-test-runner.mjs --config test-flows/cli-critical-smoke.yaml --timeout 60000",
    "check:public-narrative": "node ./scripts/validate-public-narrative.mjs",
    "check:website": "node ./scripts/validate-website.mjs",
    "lint": "npx eslint scripts/ bin/ e2e/ tests/ website/*.js --max-warnings=0",
    "lint:fix": "npx eslint --fix scripts/ bin/ e2e/ tests/ website/*.js --max-warnings=0",
    "check:coverage": "c8 --check-coverage --lines 80 --statements 80 --functions 80 --branches 65 --reporter=text node --test tests/*.test.mjs scripts/test-units.mjs",
    "typecheck": "npx tsc --noEmit",
    "check:all": "npm run check && npm run lint && npm run typecheck && npm run check:sprint && npm run check:units && npm run check:doc-store && npm run check:doc-store-mode && npm run check:cli-flows && npm run check:smoke && npm run check:observability && npm run check:mcp-resources && npm run check:protocol-fixtures && npm run check:runtime-proof && npm run check:public-narrative && npm run check:website && npm run validate:distribution",
    "check:e2e": "node e2e/run-e2e.mjs --all",
    "check:quality": "node e2e/quality/run-quality.mjs --all",
    "validate:distribution": "node ./scripts/validate-distribution.mjs",
    "auto-pilot": "node scripts/auto-pilot-loop.mjs",
    "doc-store:demo": "node ./scripts/doc-store-demo.mjs",
    "doc-store:init": "node ./scripts/doc-store-cli.mjs init",
    "doc-store:doctor": "node ./scripts/doc-store-cli.mjs doctor",
    "doc-store:enforce-staged": "node ./scripts/doc-store-cli.mjs enforce-staged",
    "prepublishOnly": "npm run check:all && npm run check:coverage && npm run check:e2e"
  },
  "dependencies": {
    "tsx": "^4.22.4",
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "va-agent-protocol": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "va-agent-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.1",
    "c8": "^11.0.0",
    "eslint": "^10.0.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "agent",
    "autonomous",
    "llm",
    "multi-agent",
    "workflow",
    "automation"
  ]
}
